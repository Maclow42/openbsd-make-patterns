# Build products
*.o
*.d
*.core
make/make
make/generate
make/*hashconsts.h
make/*hashconsts.h.tmp

# Testsuite: each test writes its outputs next to its Makefile, so
# everything in a test directory is ignored but the Makefile, the
# KNOWN_FAILURE marker and the input files listed below. Add new input
# files to this list.
testsuite/*/*
!testsuite/*/Makefile
!testsuite/*/KNOWN_FAILURE
!testsuite/14-patterned-file/file.in
!testsuite/19-vpath-pattern/src/
testsuite/19-vpath-pattern/src/*
!testsuite/19-vpath-pattern/src/file.in

# Patches: scripts/diff-upstream.sh writes to diffs/
diffs/
*.diff
*.orig
